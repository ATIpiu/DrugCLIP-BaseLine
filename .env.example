# DrugCLIP Odyssey — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored — do NOT commit API keys.

# ── LLM API (DeepSeek / OpenAI compatible) ──────────────────────────
# Used by: MainAgent, TuningAgent (planning), ModelAgent (planning)
# DeepSeek: https://api.deepseek.com
# OpenAI:   https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ── Web Search (placeholder — not yet implemented) ──────────────────
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_BASE_URL=

# ── Alternative: Anthropic-compatible env vars ─────────────────────
# Fallback env vars if LLM_* not set
# ANTHROPIC_AUTH_TOKEN=sk-your-key-here
# ANTHROPIC_BASE_URL=https://api.deepseek.com
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── ModelScope ──────────────────────────────────────────────────────
# 用于上传数据集/模型到 ModelScope：https://www.modelscope.cn/my/myaccesstoken
MODELSCOPE_TOKEN=ms-your-token-here

# ── Network ─────────────────────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ── Training defaults ───────────────────────────────────────────────
DRUGCLIP_TRAIN_DATA=data/pbpp-2020
DRUGCLIP_FASTTEST_DATA=data/fasttest
DRUGCLIP_BENCHMARK_DIR=data/benchmark/benchmark
DRUGCLIP_OUTPUT_DIR=output
DRUGCLIP_DEVICE=cuda

# ── RDKit ───────────────────────────────────────────────────────────
RDKIT_PYTHON_IGNORE_WARNINGS=1
